{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/t/:code.:ext",
      "destination": "/api/t?code=:code&ext=:ext"
    },
    {
      "source": "/t/:code",
      "destination": "/api/t?code=:code"
    },
    {
      "source": "/((?!api/|static/|google.*\\.html|sitemap\\.xml|robots\\.txt).*)",
      "destination": "/index.html"
    }
  ]
}
